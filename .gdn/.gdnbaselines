    "batchexplorer-nsis-setup-ba2009": {
      "signature": "batchexplorer-nsis-setup-ba2009",
      "alternativeSignatures": [],
      "target": "BatchExplorer Setup.exe",
      "memberOf": [
        "default"
      ],
      "tool": "binskim",
      "ruleId": "BA2009",
      "justification": "The NSIS installer stub (\"BatchExplorer Setup*.exe\") is generated by electron-builder's bundled NSIS toolchain. NSIS emits a 32-bit stub that is marked DYNAMICBASE but ships without a relocation table, which BinSkim flags as BA2009. This is an inherent limitation of NSIS and is not fixed by any electron-builder / Electron version (the main BatchExplorer.exe was fixed by bumping electron-builder to ^26). No BatchExplorer-authored code runs in the installer stub. Baselined as an accepted upstream limitation."
    }
  }
}
