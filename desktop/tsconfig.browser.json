{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "moduleResolution": "bundler"
  },
  "include": [
    "src/app",
    "src/@batch-flask/utils/logging",
  ],
  "exclude": [
    "**/*.spec.ts",
    "src/test/**/*.ts",
    "src/client",
    "test/**/*.ts",
    "**/testing**/*"
  ],
  "angularCompilerOptions": {
    "disableTypeScriptVersionCheck": true,
    "strictTemplates": false,
    "fullTemplateTypeCheck": false
  }
}
